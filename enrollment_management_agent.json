      "parameters": {
        "functionCode": "const body = items[0].json.body || items[0].json;\nconst lead_id = 'LID-' + Math.floor(Math.random() * 1000000);\nreturn [{\n  json: {\n    lead_id: lead_id,\n    name: body.name || '',\n    email: body.email || '',\n    skills: body.skills || '',\n    career_goal: body.career_goal || '',\n    gpa: Number(body.gpa) || 0,\n    programming_exp: body.programming_exp || '',\n    time_commitment: body.time_commitment || '',\n    course_expectations: body.course_expectations || ''\n  }\n}];"
      },
