      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const aiData = items[0].json;\nlet recommendations = [];\n\nif (aiData.recommendations) {\n  recommendations = aiData.recommendations;\n} else if (aiData.recommended_course) {\n  recommendations = [{\n    course_name: aiData.recommended_course,\n    fit_score: aiData.fit_score,\n    fit_level: aiData.fit_level || (aiData.fit_score >= 80 ? 'High' : 'Medium')\n  }];\n}\n\nreturn [{\n  json: {\n    recommendations: recommendations\n  }\n}];"
      },
